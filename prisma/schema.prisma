// PAOUTFIT — esquema de base de datos
// Convención: modelos y campos en camelCase para Prisma Client,
// mapeados a snake_case en la base de datos real (Postgres/Supabase).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  fulfilled
  refunded
}

enum PaymentProvider {
  wompi
  addi
}

enum DiscountType {
  percentage
  fixed
}

model Product {
  id                String   @id @default(uuid())
  handle            String   @unique
  title             String
  descriptionHtml   String?  @map("description_html")
  titleEn           String?  @map("title_en")
  descriptionHtmlEn String?  @map("description_html_en")
  category          String
  basePriceCop      Int      @map("base_price_cop")
  compareAtPriceCop Int?     @map("compare_at_price_cop")
  isPublished       Boolean  @default(true) @map("is_published")
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]
  images   ProductImage[]

  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  colorName    String   @map("color_name")
  colorHex     String?  @map("color_hex")
  sku          String   @unique
  priceCop     Int      @map("price_cop")
  inventoryQty Int      @default(0) @map("inventory_qty")
  isActive     Boolean  @default(true) @map("is_active")
  position     Int      @default(0) @map("position")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  variantId   String?  @map("variant_id")
  storagePath String   @map("storage_path")
  angle       String?
  position    Int      @default(0)
  altText     String?  @map("alt_text")
  createdAt   DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique @map("order_number")
  status           OrderStatus     @default(pending)
  customerName     String          @map("customer_name")
  customerEmail    String          @map("customer_email")
  customerPhone    String          @map("customer_phone")
  shippingAddress  Json            @map("shipping_address")
  subtotalCop      Int             @map("subtotal_cop")
  discountCop      Int             @default(0) @map("discount_cop")
  shippingCop      Int             @default(0) @map("shipping_cop")
  totalCop         Int             @map("total_cop")
  discountCodeId   String?         @map("discount_code_id")
  paymentProvider  PaymentProvider @map("payment_provider")
  paymentReference String?         @map("payment_reference")
  utmSource        String?         @map("utm_source")
  utmMedium        String?         @map("utm_medium")
  utmCampaign      String?         @map("utm_campaign")
  referrer         String?
  landingPath      String?         @map("landing_path")
  carrier          String?         @default("ENVIA")
  trackingNumber   String?         @map("tracking_number")
  fulfilledAt      DateTime?       @map("fulfilled_at")
  dataPolicyAcceptedAt DateTime?   @map("data_policy_accepted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  discountCode  DiscountCode?      @relation(fields: [discountCodeId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusEvent[]

  @@index([customerEmail])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String @map("order_id")
  variantId    String @map("variant_id")
  productTitle String @map("product_title")
  colorName    String @map("color_name")
  sku          String
  unitPriceCop Int    @map("unit_price_cop")
  quantity     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  status          OrderStatus
  source          String
  providerEventId String?     @map("provider_event_id")
  rawPayload      Json?       @map("raw_payload")
  createdAt       DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model PaymentWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @map("event_id")
  payload     Json
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model DiscountCode {
  id        String       @id @default(uuid())
  code      String       @unique
  type      DiscountType
  value     Int
  maxUses   Int?         @map("max_uses")
  usesCount Int          @default(0) @map("uses_count")
  isActive  Boolean      @default(true) @map("is_active")
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  orders      Order[]
  subscribers Subscriber[]

  @@map("discount_codes")
}

model Subscriber {
  id             String   @id @default(uuid())
  email          String   @unique
  source         String   @default("popup")
  discountCodeId String?  @map("discount_code_id")
  createdAt      DateTime @default(now()) @map("created_at")

  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])

  @@map("subscribers")
}
